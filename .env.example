# Origin of the Zeroara deployment that serves /sdk/zeroara.js.
# Production default (when unset): https://zeroara.vercel.app
# Local development against a Zeroara dev server:
VITE_ZEROARA_ORIGIN=http://localhost:1420

# How Zeroara opens: auto (popup, overlay fallback) | popup | iframe (overlay inside the page)
#                    | desktop (installed Zeroara app via zeroara:// + verifier API, web overlay fallback)
# VITE_ZEROARA_MODE=auto
# Verifier API for desktop mode (default: same as VITE_ZEROARA_ORIGIN, which hosts /api/verify/* on Vercel)
# VITE_ZEROARA_API=https://zeroara.vercel.app
